{
  "name": "@acramsay/opencode-shield-bash",
  "version": "2.1.1",
  "description": "opencode v2 plugin that gates shell tool calls through a second-session allow/deny judge",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src/index.ts",
    "src/judge.ts",
    "src/lib.ts",
    "src/rpc.ts",
    "src/tui.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "test:integration": "bun test test/integration.test.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acramsay/opencode-shield-bash.git"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogTitle": "# Changelog"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  }
}
